"""
Construye un dataset con una fila por (test, subciclo), en vez de una fila
por test entero. Cada fila incluye:
  - VIB (categoria, para que el modelo distinga familias/productos)
  - nivel de cada fuego, obtenido de QIT_DB.QIT2_Subciclos.Nombre (via
    QIT2_Ciclos_Subciclos/QIT2_Ciclos), parseado con el mismo regex que
    ya usa app2.py -- NO se infiere de SbRep.Subcycle, que es solo un
    indice de orden de ejecucion sin informacion de configuracion.
  - estadisticos (mean/std/min/max) de las variables de potencia (y
    temperatura si existe) para ese subciclo concreto, dentro de la
    ventana temprana del test.

Requiere:
    pip install pandas pyodbc sqlalchemy tqdm

Uso:
    python 04_build_subcycle_dataset.py
Salida:
    subciclos_features.parquet
"""

import re
import pandas as pd
import numpy as np
from sqlalchemy import create_engine
from tqdm import tqdm

# ============================== CONFIG ==============================

# Servidor donde vive Measurement_all
CONN_STR = (
    "mssql+pyodbc://@TU_SERVIDOR/QIT_DATAMINING_20"
    "?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes"
)

# Servidor donde vive QIT_DB (Ensayos, y tambien QIT2_Ciclos_Subciclos /
# QIT2_Subciclos / QIT2_Ciclos, la definicion real de cada subciclo)
CONN_STR_QITDB = (
    "mssql+pyodbc://@TU_SERVIDOR_QITDB/QIT_DB"
    "?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes"
)

ENSAYOS_CSV = "ensayos_ipr_todos.csv"

EARLY_FRACTION = 0.40   # ver nota en scripts anteriores sobre IPR vs FIA

# Ya no filtramos variables desde Python: la query usa
# VA.Variable_Name LIKE 'Measured_Power%' directamente en SQL, así cogemos
# todas las variantes de fuego/modulo (F1, F2, PAN_F1, etc.) sin tener que
# mantener una lista manual.

# Regex mas tolerante: cualquier cosa entre "Measured_Power_" y el sufijo
# final "_M{numero}" se toma como identificador canonico del fuego.
VAR_PATTERN = re.compile(r"^Measured_Power_(.+?)_M\d+$")
TEMP_PATTERN = re.compile(r"^Temperature_Glass_(.+?)_M\d+$")

# Mismo regex que ya usa la app para extraer niveles de fuego del NOMBRE
# del subciclo (campo QIT2_Subciclos.Nombre, no SbRep.Subcycle)
SUBCYCLE_NAME_PATTERN = r"F(\d+)_N?([a-zA-Z0-9\[\]]+)"

STATS = ["mean_val", "std_val", "min_val", "max_val"]

OUTPUT_PATH = "subciclos_features.parquet"

# ======================================================================


def conversion_segura_int(val):
    """Copiado de app2.py: algunos niveles no son puramente numericos."""
    try:
        return int(float(val))
    except (ValueError, TypeError):
        return val


def fetch_subcycle_definitions(engine_qitdb, test_names):
    """
    Trae, para el conjunto de TestName presentes en el dataset, la
    definicion real de cada subciclo (Nombre) desde QIT_DB, y parsea los
    niveles de fuego con el mismo regex que ya usa la app.
    Se hace UNA vez para todos los tests (no por test), igual que en app2.py.
    """
    tests_in_list = ", ".join(f"'{t}'" for t in test_names)
    query_ciclos = f"""
        SELECT c.[Nombre_Identificador_Ciclo] AS TestName,
               cs.[OrdenEjecucion] AS Subcycle,
               s.[Nombre]
        FROM [QIT_DB].[dbo].[QIT2_Ciclos_Subciclos] cs
        INNER JOIN [QIT_DB].[dbo].[QIT2_Subciclos] s
            ON cs.[ID_Subiclo] = s.[ID_Subciclo]
        INNER JOIN [QIT_DB].[dbo].[QIT2_Ciclos] c
            ON c.ID_Ciclo = cs.ID_Ciclo
        WHERE c.[Nombre_Identificador_Ciclo] IN ({tests_in_list})
    """
    df_ciclos = pd.read_sql(query_ciclos, engine_qitdb)
    df_ciclos["TestName"] = df_ciclos["TestName"].astype(str)
    df_ciclos["Subcycle"] = df_ciclos["Subcycle"].astype(int)

    patrones = df_ciclos["Nombre"].fillna("").str.extractall(SUBCYCLE_NAME_PATTERN)
    if not patrones.empty:
        df_niveles = patrones[1].unstack(level="match")
        df_niveles.columns = [f"nivel_F{i+1}" for i in range(df_niveles.shape[1])]
        for col in df_niveles.columns:
            df_niveles[col] = df_niveles[col].apply(conversion_segura_int)
        df_ciclos = df_ciclos.join(df_niveles)

    return df_ciclos.rename(columns={"Nombre": "Subcycle_Name"})


def build_query():
    return """
    SELECT
        SbRep.Subcycle,
        SbRep.Repetition,
        VA.Variable_Name,
        COUNT(*)                              AS n_points,
        AVG(CAST(m.Measurement AS FLOAT))     AS mean_val,
        STDEV(CAST(m.Measurement AS FLOAT))   AS std_val,
        MIN(m.Measurement)                    AS min_val,
        MAX(m.Measurement)                    AS max_val
    FROM Measurement_all AS m
    JOIN VA        ON m.ID_VA = VA.ID_VA
    JOIN Sequence  AS seq ON m.ID_Sequence = seq.ID_Sequence
    JOIN SbRep     ON seq.ID_SbRep = SbRep.ID_SbRep
    JOIN TIP       ON SbRep.ID_TIP = TIP.ID_TIP
    JOIN TPS       ON TPS.ID_TPS = TIP.ID_TPS
    JOIN DUT       ON DUT.ID_DUT = TPS.ID_DUT
    WHERE DUT.SNR = ?
      AND DUT.FD = ?
      AND DUT.VIB = ?
      AND TIP.TestName = ?
      AND seq.TimeStamp >= ?
      AND seq.TimeStamp < ?
      AND (VA.Variable_Name LIKE 'Measured_Power%'
           OR VA.Variable_Name LIKE 'Temperature_Glass%')
    GROUP BY SbRep.Subcycle, SbRep.Repetition, VA.Variable_Name
    """


def canonical_name(var_name):
    """Measured_Power_F3_M80 -> Power_F3 ; Temperature_Glass_F3_M80 -> Temp_F3"""
    m = VAR_PATTERN.match(var_name)
    if m:
        return f"Power_{m.group(1)}"
    m = TEMP_PATTERN.match(var_name)
    if m:
        return f"Temp_{m.group(1)}"
    return var_name


def compute_reference_duration(ensayos):
    """Duracion de referencia (mediana global de OK) para fijar el corte
    de la ventana temprana sin fuga de informacion (ver script anterior)."""
    ok = ensayos[ensayos["Resultado"].astype(str).str.upper() == "OK"].copy()
    ok["duracion_h"] = (
        pd.to_datetime(ok["FechaFin"]) - pd.to_datetime(ok["FechaInicio"])
    ).dt.total_seconds() / 3600
    return ok["duracion_h"].median()


def main():
    ensayos = pd.read_csv(ENSAYOS_CSV)
    print(f"Tests a procesar: {len(ensayos)}")

    ref_duration = compute_reference_duration(ensayos)
    print(f"Duracion de referencia (mediana OK): {ref_duration:.1f} h")

    engine = create_engine(CONN_STR)
    engine_qitdb = create_engine(CONN_STR_QITDB)
    query = build_query()

    # Definicion de subciclos (niveles de fuego), UNA sola vez para todos
    # los TestName presentes, igual que hace app2.py
    test_names = ensayos["TestName"].unique().tolist()
    df_subciclos_def = fetch_subcycle_definitions(engine_qitdb, test_names)
    nivel_cols = [c for c in df_subciclos_def.columns if c.startswith("nivel_F")]
    print(f"Definiciones de subciclo cargadas: {len(df_subciclos_def)} "
          f"({len(nivel_cols)} fuegos detectados)")

    all_rows = []
    for _, row in tqdm(ensayos.iterrows(), total=len(ensayos)):
        fecha_inicio = pd.to_datetime(row["FechaInicio"])
        cutoff = fecha_inicio + pd.Timedelta(hours=ref_duration * EARLY_FRACTION)

        params = [row["SNR"], row["FD"], row["VIB"], row["TestName"],
                   fecha_inicio, cutoff]
        try:
            df = pd.read_sql(query, engine, params=params)
        except Exception as e:
            print(f"  [WARN] fallo consultando SNR={row['SNR']} Test={row['TestName']}: {e}")
            continue
        if df.empty:
            continue

        df["var_canon"] = df["Variable_Name"].apply(canonical_name)

        # niveles de fuego de este TestName (misma definicion para todas
        # las unidades que corren ese ciclo)
        niveles_test = df_subciclos_def[df_subciclos_def["TestName"] == row["TestName"]]

        for (subciclo, repeticion), grupo in df.groupby(["Subcycle", "Repetition"]):
            fila_niveles = niveles_test[niveles_test["Subcycle"] == subciclo]
            fila = {col: (fila_niveles.iloc[0][col] if not fila_niveles.empty else np.nan)
                    for col in nivel_cols}

            fila["VIB"] = row["VIB"]
            fila["SNR"] = row["SNR"]
            fila["TestName"] = row["TestName"]
            fila["Subcycle"] = subciclo
            fila["Repetition"] = repeticion
            fila["Resultado"] = row["Resultado"]

            for _, r in grupo.iterrows():
                for stat in STATS:
                    fila[f"{stat}__{r['var_canon']}"] = r[stat]

            all_rows.append(fila)

    dataset = pd.DataFrame(all_rows)
    print(f"\nDataset final: {dataset.shape[0]} filas (test x subciclo) "
          f"x {dataset.shape[1]} columnas")
    dataset.to_parquet(OUTPUT_PATH, index=False)
    print(f"Guardado en {OUTPUT_PATH}")


if __name__ == "__main__":
    main()
