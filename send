"""
Segunda fase del diagnostico: localizar QUE variables difieren entre lo
que construye la app y lo que se uso para entrenar (guardado en
subciclos_con_scores.parquet), para un ensayo concreto.

Uso:
    python 14_diagnostico_variables.py
"""

import importlib.util
import numpy as np
import pandas as pd
from sqlalchemy import create_engine

# Uno de los ensayos que SI se pudo comparar en 13_diagnostico_app.py
TEST_SNR = "000222"
TEST_VIB = "PVQ61CHB1E"
TEST_NAME = "CC_IPR_IH_4I_MT+_---_1_7"

spec = importlib.util.spec_from_file_location("app_mod", "app_tab_anomalias.py")
app_mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(app_mod)
build_ds = app_mod.build_ds


def norm_snr(s):
    return str(s).lstrip("0")


def main():
    bundle = app_mod.cargar_modelo()
    feature_cols = bundle["feature_cols"]

    df_hist = pd.read_parquet("subciclos_con_scores.parquet")
    hist = df_hist[(df_hist["SNR"].apply(norm_snr) == norm_snr(TEST_SNR))
                   & (df_hist["VIB"] == TEST_VIB)
                   & (df_hist["TestName"] == TEST_NAME)]
    print(f"Filas del ensayo en el parquet: {len(hist)}")

    engine = create_engine(build_ds.CONN_STR)
    engine_qitdb = create_engine(build_ds.CONN_STR_QITDB)

    q = """
        SELECT SNR, FD, VIB, Ciclo AS TestName, FechaInicio, FechaFin
        FROM QIT_DB.dbo.Ensayos
        WHERE Area='IPR' AND VIB = ? AND Ciclo = ?
    """
    info = pd.read_sql(q, engine_qitdb, params=(TEST_VIB, TEST_NAME),
                       dtype={"SNR": str, "FD": str})
    info = info[info["SNR"].apply(norm_snr) == norm_snr(TEST_SNR)]
    fila = info.iloc[0]

    feats = app_mod.construir_features_test(
        engine, engine_qitdb, fila["SNR"], fila["FD"], TEST_VIB,
        TEST_NAME, fila["FechaInicio"], fila["FechaFin"])
    print(f"Filas construidas por la app: {len(feats)}")

    m = feats.merge(hist, on=["Subcycle", "Repetition"],
                    suffixes=("_app", "_hist"), how="inner")
    print(f"Subciclos comunes: {len(m)}\n")

    resultados = []
    for col in feature_cols:
        ca, ch = f"{col}_app", f"{col}_hist"
        if ca not in m.columns or ch not in m.columns:
            # la columna no tiene sufijo si solo existia en uno de los dos lados
            estado = []
            if col in feats.columns: estado.append("solo app")
            if col in hist.columns: estado.append("solo parquet")
            if col not in feats.columns and col not in hist.columns:
                estado.append("en ninguno (NaN por imputacion en ambos)")
            resultados.append((col, np.nan, np.nan, np.nan, " / ".join(estado)))
            continue
        va, vh = m[ca], m[ch]
        if not (np.issubdtype(va.dtype, np.number) and np.issubdtype(vh.dtype, np.number)):
            iguales = (va.astype(str) == vh.astype(str)).all()
            resultados.append((col, np.nan, np.nan, np.nan,
                               "categorica igual" if iguales else "CATEGORICA DISTINTA"))
            continue
        ambos = va.notna() & vh.notna()
        solo_app_nan = (va.isna() & vh.notna()).sum()
        solo_hist_nan = (vh.isna() & va.notna()).sum()
        diff = (va[ambos] - vh[ambos]).abs()
        max_d = diff.max() if len(diff) else 0.0
        resultados.append((col, max_d,
                           va[ambos].mean() if ambos.any() else np.nan,
                           vh[ambos].mean() if ambos.any() else np.nan,
                           f"NaN solo en app: {solo_app_nan}, solo en parquet: {solo_hist_nan}"))

    tabla = pd.DataFrame(resultados, columns=["columna", "max_diff", "media_app", "media_parquet", "nota"])
    tabla = tabla.sort_values("max_diff", ascending=False, na_position="last")
    pd.set_option("display.width", 200)
    print("===== Top 20 columnas con mayor discrepancia =====")
    print(tabla.head(20).to_string(index=False))
    tabla.to_csv("diagnostico_variables.csv", index=False)
    print("\nGuardado diagnostico_variables.csv (todas las columnas)")


if __name__ == "__main__":
    main()
