-- Comprobacion rapida: proporcion OK / NOK_FUNC / NOK_EST / NOK_FUNC_EST
-- en IPR, restringido a tests cuya etapa temprana puede reconstruirse
-- (arrancaron a partir de cuando la BBDD actual empieza a grabar bien).

SELECT
    Resultado,
    COUNT(*)                                              AS n,
    AVG(DATEDIFF(hour, FechaInicio, FechaFin))             AS horas_media,
    MIN(FechaInicio)                                       AS primer_inicio,
    MAX(FechaInicio)                                       AS ultimo_inicio
FROM QIT_DB.dbo.Ensayos
WHERE Area = 'IPR'
  AND Resultado IS NOT NULL
  AND (Eliminado IS NULL OR Eliminado = 0)
  AND Estado IN (4, 5)                       -- Pendiente de Analisis, Finalizado
  AND FechaFin IS NOT NULL
  AND DATEDIFF(hour, FechaInicio, FechaFin) > 0
  AND FechaInicio >= '2026-04-09'             -- arranque real de Measurement_all
GROUP BY Resultado
ORDER BY n DESC;

