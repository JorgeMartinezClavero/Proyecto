-- Ejecutar en el servidor donde vive QIT_DB.dbo.Ensayos
-- Exportar el resultado a CSV (botón derecho en SSMS -> "Save Results As" o Result to File)
-- Este CSV es el input de 02_build_dataset.py

SELECT
    ID,
    Area,
    TipoFIA,
    Ubicacion,
    VIB,
    FD,
    SNR,
    Ciclo            AS TestName,
    FechaInicio,
    FechaFin,
    FechaFinEstimada,
    Subciclo          AS UltimoSubciclo,   -- punto donde se detuvo el test (útil como feature)
    Repeticion        AS UltimaRepeticion, -- idem
    Estado,
    Resultado,
    SerieControlada,
    PruebaEspecifica
FROM QIT_DB.dbo.Ensayos
WHERE Area = 'FIA'
  AND Resultado IS NOT NULL
  AND (Eliminado IS NULL OR Eliminado = 0)
  -- Solo tests con resultado ya determinado y fecha de fin real y coherente.
  -- Excluye Ejecucion/Esperando.../Pausado, donde FechaFin suele ser un valor
  -- por defecto y el Resultado no es fiable todavia.
  AND Estado IN (4, 5)                                  -- Pendiente de Analisis, Finalizado
  AND FechaFin IS NOT NULL
  AND DATEDIFF(hour, FechaInicio, FechaFin) > 0
  -- Excluimos defectos puramente esteticos: no son explicables por las
  -- variables electricas/termicas que monitorizamos.
  AND Resultado <> 'NOK_EST'
ORDER BY FechaInicio;

