"""
Diagnostico rapido: mira que esta capturando de verdad el regex de
niveles de fuego ANTES de convertirlo a numero, para ver por que solo
sale el valor 19 (BA).

Reutiliza las funciones de 04_build_subcycle_dataset.py (ajusta el
nombre del fichero si lo llamaste distinto).

Uso:
    python diagnostico_niveles.py
"""

import importlib.util
import pandas as pd

spec = importlib.util.spec_from_file_location("build_ds", "04_build_subcycle_dataset.py")
build_ds = importlib.util.module_from_spec(spec)
spec.loader.exec_module(build_ds)

ENSAYOS_CSV = "ensayos_ipr_todos.csv"


def main():
    ensayos = pd.read_csv(ENSAYOS_CSV, sep=';',
                           dtype={"FD": str, "SNR": str, "VIB": str, "TestName": str})
    test_names = ensayos["TestName"].dropna().unique().tolist()

    engine_qitdb = build_ds.create_engine(build_ds.CONN_STR_QITDB)

    query_ciclos = f"""
        SELECT c.[Nombre_Identificador_Ciclo] AS TestName,
               cs.[OrdenEjecucion] AS Subcycle,
               s.[Nombre]
        FROM [QIT_DB].[dbo].[QIT2_Ciclos_Subciclos] cs
        INNER JOIN [QIT_DB].[dbo].[QIT2_Subciclos] s
            ON cs.[ID_Subiclo] = s.[ID_Subciclo]
        INNER JOIN [QIT_DB].[dbo].[QIT2_Ciclos] c
            ON c.ID_Ciclo = cs.ID_Ciclo
        WHERE c.[Nombre_Identificador_Ciclo] IN ({', '.join(repr(t) for t in test_names)})
    """
    df_ciclos = pd.read_sql(query_ciclos, engine_qitdb)

    print(f"Definiciones de subciclo cargadas: {len(df_ciclos)}")
    print("\n===== Ejemplos de nombres de subciclo tal cual vienen de la BBDD =====")
    print(df_ciclos["Nombre"].dropna().drop_duplicates().head(20).to_string(index=False))

    print("\n===== Todo lo que el regex SUBCYCLE_NAME_PATTERN captura como 'nivel' (antes de convertir) =====")
    patrones = df_ciclos["Nombre"].fillna("").str.extractall(build_ds.SUBCYCLE_NAME_PATTERN)
    if patrones.empty:
        print("[AVISO] El regex no ha encontrado NINGUNA coincidencia -- revisar formato real del nombre.")
    else:
        print("Valores capturados en el grupo 'nivel' (columna 1), con su frecuencia:")
        print(patrones[1].value_counts().head(30))

    print("\n===== Como quedan tras aplicar parse_nivel_fuego =====")
    if not patrones.empty:
        convertidos = patrones[1].apply(build_ds.parse_nivel_fuego)
        print(convertidos.value_counts(dropna=False).head(30))
        if build_ds.UNMAPPED_CODES:
            print("\nCodigos no reconocidos (fuera de F{x} y BA):", sorted(build_ds.UNMAPPED_CODES))

        print("\n===== Valores reales (con repr, para ver caracteres ocultos) "
              "y su conversion, uno a uno =====")
        muestra = patrones[1].dropna().unique()[:25]
        for val in muestra:
            print(f"  repr={repr(val):20s} -> parse_nivel_fuego = {build_ds.parse_nivel_fuego(val)}")


if __name__ == "__main__":
    main()
