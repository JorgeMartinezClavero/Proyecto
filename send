-- Poblacion completa de tests IPR desde que la BBDD actual graba bien.
-- A diferencia de la extraccion anterior, AQUI NO filtramos por Estado ni
-- por Resultado: para entrenar el modelo de anomalias no necesitamos
-- etiqueta, y cuantos mas tests "normales" incluyamos (incluso en curso),
-- mejor aprende el modelo que es comportamiento tipico.
-- Resultado se conserva solo para la validacion cualitativa posterior
-- (comprobar si los pocos NOK reales conocidos puntuan como anomalos).

SELECT
    ID,
    VIB,
    FD,
    SNR,
    Ciclo AS TestName,
    FechaInicio,
    FechaFin,
    Subciclo AS UltimoSubciclo,
    Repeticion AS UltimaRepeticion,
    Estado,
    Resultado
FROM QIT_DB.dbo.Ensayos
WHERE Area = 'IPR'
  AND (Eliminado IS NULL OR Eliminado = 0)
  AND FechaInicio >= '2026-04-09'
ORDER BY FechaInicio;

