"""
Diagnostico: por que la app marca (casi) todo como alerta.

Compara, para varios ensayos OK ANTIGUOS (presentes en el dataset de
entrenamiento), el score que calcula la app en vivo contra el score ya
guardado en subciclos_con_scores.parquet para ese mismo ensayo.

  - Si los scores COINCIDEN (diferencias ~0): la construccion de
    variables de la app es correcta, y el problema es el sesgo
    dentro/fuera de muestra de la referencia (hipotesis B) -> habra que
    reconstruir la referencia con validacion cruzada.
  - Si los scores NO COINCIDEN: hay un desajuste en la construccion de
    variables de la app (hipotesis A) -> comparar columnas para
    localizarlo.

Requiere (misma carpeta): modelo_final_pca.joblib, subciclos_con_scores.parquet,
04_build_subcycle_dataset.py, app_tab_anomalias.py, acceso a la BBDD.

Uso:
    python 13_diagnostico_app.py
"""

import importlib.util
import numpy as np
import pandas as pd
from sqlalchemy import create_engine

N_TESTS = 5
RANDOM_STATE = 7

spec = importlib.util.spec_from_file_location("app_mod", "app_tab_anomalias.py")
app_mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(app_mod)
build_ds = app_mod.build_ds


def norm_snr(s):
    return str(s).lstrip("0")


def main():
    bundle = app_mod.cargar_modelo()
    df_hist = pd.read_parquet("subciclos_con_scores.parquet")
    score_col = [c for c in df_hist.columns if c.startswith("anomaly_score__PCA")][0]

    ok_tests = (df_hist[df_hist["Resultado"].astype(str).str.upper() == "OK"]
                [["SNR", "VIB", "TestName"]].drop_duplicates()
                .sample(n=N_TESTS, random_state=RANDOM_STATE))

    engine = create_engine(build_ds.CONN_STR)
    engine_qitdb = create_engine(build_ds.CONN_STR_QITDB)

    print(f"Percentiles de la referencia guardada: n={len(bundle['referencia_scores_test'])}, "
          f"min={bundle['referencia_scores_test'].min():.5f}, "
          f"p50={np.median(bundle['referencia_scores_test']):.5f}, "
          f"max={bundle['referencia_scores_test'].max():.5f}\n")

    for _, t in ok_tests.iterrows():
        q = """
            SELECT TOP 1 SNR, FD, VIB, Ciclo AS TestName, FechaInicio, FechaFin
            FROM QIT_DB.dbo.Ensayos
            WHERE Area='IPR' AND VIB = ? AND Ciclo = ?
        """
        info = pd.read_sql(q, engine_qitdb, params=(t["VIB"], t["TestName"]),
                           dtype={"SNR": str, "FD": str})
        info = info[info["SNR"].apply(norm_snr) == norm_snr(t["SNR"])]
        if info.empty:
            info = pd.read_sql(q, engine_qitdb, params=(t["VIB"], t["TestName"]),
                               dtype={"SNR": str, "FD": str})
            if info.empty:
                print(f"[{t['SNR']}/{t['VIB']}/{t['TestName']}] no encontrado en Ensayos, salto")
                continue
        fila = info.iloc[0]

        feats = app_mod.construir_features_test(
            engine, engine_qitdb, fila["SNR"], fila["FD"], t["VIB"],
            t["TestName"], fila["FechaInicio"], fila["FechaFin"])
        if feats is None or feats.empty:
            print(f"[{t['SNR']}/{t['VIB']}/{t['TestName']}] sin datos de sensores, salto")
            continue

        scores, _, percentil_test = app_mod.puntuar(feats, bundle)
        feats["score_app"] = scores

        hist = df_hist[(df_hist["SNR"].apply(norm_snr) == norm_snr(t["SNR"]))
                       & (df_hist["VIB"] == t["VIB"])
                       & (df_hist["TestName"] == t["TestName"])]
        m = feats.merge(hist[["Subcycle", "Repetition", score_col]],
                        on=["Subcycle", "Repetition"], how="inner")
        if m.empty:
            print(f"[{t['SNR']}/{t['VIB']}/{t['TestName']}] sin subciclos comunes para comparar")
            continue

        diff = (m["score_app"] - m[score_col]).abs()
        print(f"[{t['SNR']}/{t['VIB']}/{t['TestName']}] subciclos comparados: {len(m)}")
        print(f"    score guardado (max): {m[score_col].max():.5f}   "
              f"score app (max): {m['score_app'].max():.5f}")
        print(f"    diferencia absoluta por subciclo: media={diff.mean():.6f}  max={diff.max():.6f}")
        print(f"    percentil del ensayo segun la app: {percentil_test:.1%}  "
              f"(es un ensayo OK antiguo: deberia salir mayoritariamente verde)\n")

    print("Interpretacion: diferencias ~0 pero percentiles altos -> hipotesis B "
          "(referencia dentro-de-muestra). Diferencias grandes -> hipotesis A "
          "(desajuste de variables en la app).")


if __name__ == "__main__":
    main()
