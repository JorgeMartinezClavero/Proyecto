"""
Explora, con los datos ya guardados (sin reentrenar nada), que recall
(% de fallos reales capturados) y que tasa de alerta sobre ensayos
normales se obtiene con distintos umbrales de percentil -- para decidir
con datos, no a ojo, si el 20% (percentil 80) es el punto adecuado dado
lo poco frecuente que es el fallo real.

Requiere:
    subciclos_con_scores.parquet   (de 05_train_anomaly_models.py)
    candidatos_subciclo_alto.csv   (de check_casos_fiables.py)

Uso:
    python 11_explorar_umbral.py
"""

import pandas as pd
import numpy as np

SCORES_PARQUET = "subciclos_con_scores.parquet"
CANDIDATOS_CSV = "candidatos_subciclo_alto.csv"
MODELO = "anomaly_score__OneClassSVM"  # cambia aqui el modelo a analizar segun
                                        # lo que diga 07_test_significancia.py
                                        # (ej. "anomaly_score__PCA (autoencoder lineal)")

# Umbrales candidatos, expresados como "% de ensayos normales marcados
# como alerta" (top X% mas anomalo)
UMBRALES_PCT_ALERTA = [30, 25, 20, 15, 10, 7, 5, 3]


def main():
    df = pd.read_parquet(SCORES_PARQUET)
    candidatos = pd.read_csv(
        CANDIDATOS_CSV, dtype={"SNR": str, "VIB": str, "TestName": str, "FD": str}
    )
    fiables = candidatos[candidatos["tiene_datos"].astype(str).str.lower() == "true"]
    claves_fiables = set(zip(fiables["SNR"], fiables["VIB"], fiables["TestName"]))

    es_nok = df["Resultado"].astype(str).str.upper().isin(["NOK_FUNC", "NOK_FUNC_EST"])
    es_fiable = df.apply(lambda r: (r["SNR"], r["VIB"], r["TestName"]) in claves_fiables, axis=1)
    df["_nok_fiable"] = es_nok & es_fiable

    # Agregamos a nivel de TEST (maximo), igual que hace ahora la app
    grp = df.groupby(["SNR", "VIB", "TestName"])
    agg_max = grp[MODELO].max()
    es_nok_test = grp["_nok_fiable"].max().astype(bool)
    agg = pd.DataFrame({"score_max": agg_max, "es_nok": es_nok_test}).reset_index()

    # Referencia: SOLO ensayos normales (igual que en el modelo guardado)
    referencia = np.sort(agg.loc[~agg["es_nok"], "score_max"].values)

    n_nok_total = int(agg["es_nok"].sum())
    n_tests_total = len(agg)
    print(f"Ensayos en el conjunto: {n_tests_total}  |  NOK reales fiables: {n_nok_total}")
    print(f"Tasa base de fallo real en la muestra: {n_nok_total/n_tests_total:.1%}\n")

    agg["percentil"] = agg["score_max"].apply(
        lambda s: np.searchsorted(referencia, s) / len(referencia)
    )

    resultados = []
    for pct_alerta in UMBRALES_PCT_ALERTA:
        umbral = 1 - pct_alerta / 100
        capturados = agg.loc[agg["es_nok"], "percentil"] > umbral
        n_capturados = int(capturados.sum())
        recall = n_capturados / n_nok_total if n_nok_total else float("nan")

        # de todos los ensayos marcados en alerta, cuantos son REALMENTE NOK
        # (precision) -- con esta tasa base tan baja, sera un numero pequeño
        marcados = agg["percentil"] > umbral
        n_marcados = int(marcados.sum())
        precision = n_capturados / n_marcados if n_marcados else float("nan")

        resultados.append({
            "top_%_marcado": pct_alerta,
            "n_ensayos_marcados": n_marcados,
            "NOK_capturados": f"{n_capturados}/{n_nok_total}",
            "recall": f"{recall:.1%}",
            "precision (de los marcados, % que son NOK de verdad)": f"{precision:.1%}",
        })

    tabla = pd.DataFrame(resultados)
    print("===== Umbral vs. recall vs. precision (agregacion por maximo) =====")
    print(tabla.to_string(index=False))
    tabla.to_csv("exploracion_umbral.csv", index=False)
    print("\nGuardado exploracion_umbral.csv")
    print("\nNota: 'precision' es necesariamente baja con una tasa base de fallo tan "
          "reducida -- incluso un modelo excelente marcara mayoria de 'falsos positivos' "
          "en terminos absolutos. Lo relevante es cuanto 'recall' se gana o se pierde al "
          "mover el umbral, y decidir el punto de equilibrio segun cuantos ensayos esta "
          "dispuesto a revisar el laboratorio.")


if __name__ == "__main__":
    main()
