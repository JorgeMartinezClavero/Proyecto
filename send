import pandas as pd
df = pd.read_parquet("subciclos_features.parquet")

print(df.shape)
print(df["Resultado"].value_counts(dropna=False))
print(df["VIB"].nunique(), "VIBs distintos")

nivel_cols = [c for c in df.columns if c.startswith("nivel_F")]
print(df[nivel_cols].isna().mean())  # % de NaN por columna de nivel

power_cols = [c for c in df.columns if c.startswith("mean_val__Power")]
print(df[power_cols].isna().mean())  # % de NaN por variable de potencia
