"""
Comprobacion rapida del dataset recien generado por
04_build_subcycle_dataset.py, antes de lanzar el resto del pipeline.
Muestra forma, columnas por familia, estadisticos descriptivos y una
muestra de filas para las variables nuevas (Temperature_Glass,
UI_Target_Power, power_tracking_error).

Uso:
    python verificar_dataset.py
"""

import pandas as pd

DATA_PATH = "subciclos_features.parquet"


def main():
    df = pd.read_parquet(DATA_PATH)
    print(f"Dataset: {df.shape[0]} filas x {df.shape[1]} columnas\n")

    familias = {
        "Niveles de fuego": [c for c in df.columns if c.startswith("nivel_F")],
        "Potencia medida": [c for c in df.columns if "Measured_Power" in c],
        "Temperatura de cristal": [c for c in df.columns if "Temperature_Glass" in c],
        "Consigna de potencia": [c for c in df.columns if "UI_Target_Power" in c],
        "Error de seguimiento (derivada)": [c for c in df.columns if c.startswith("power_tracking_error")],
    }

    for nombre, cols in familias.items():
        print(f"=== {nombre}: {len(cols)} columnas ===")
        print(cols)
        print()

    # Estadisticos descriptivos + % de NaN, solo de las familias nuevas/derivadas
    cols_nuevas = (familias["Temperatura de cristal"]
                   + familias["Consigna de potencia"]
                   + familias["Error de seguimiento (derivada)"])
    if cols_nuevas:
        resumen = df[cols_nuevas].describe().T
        resumen["pct_missing"] = df[cols_nuevas].isna().mean() * 100
        print("=== Estadisticos descriptivos de las variables nuevas ===")
        print(resumen.to_string())
        resumen.to_csv("verificacion_variables_nuevas.csv")
        print("\nGuardado verificacion_variables_nuevas.csv")
    else:
        print("[AVISO] No se encontraron columnas de Temperature_Glass / "
              "UI_Target_Power / power_tracking_error -- revisa si el script "
              "04_build_subcycle_dataset.py que corriste ya incluye estas variables.")

    # Muestra de filas concretas, para ver los valores con tus propios ojos
    cols_muestra = ["SNR", "TestName", "Subcycle"] + \
        [c for c in df.columns if "F1" in c and
         ("Measured_Power" in c or "UI_Target_Power" in c or "power_tracking_error" in c)]
    print("\n=== Muestra de filas (fuego 1, para comprobar a ojo consigna vs medido vs error) ===")
    print(df[cols_muestra].dropna(subset=[c for c in cols_muestra if "power_tracking_error" in c]).head(10).to_string(index=False))


if __name__ == "__main__":
    main()
