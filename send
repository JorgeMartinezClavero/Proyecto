"""
En vez de mirar el score de anomalia subciclo a subciclo, lo agregamos a
nivel de TEST completo (maximo y percentil 95 de sus subciclos) y
comprobamos si la separacion entre tests OK y NOK reales mejora respecto
a mirar cada subciclo suelto. No hace falta reentrenar nada.

Uso:
    python comprobar_agregado_test.py
"""

import pandas as pd

SCORES_PARQUET = "subciclos_con_scores.parquet"
CANDIDATOS_CSV = "candidatos_subciclo_alto.csv"


def main():
    df = pd.read_parquet(SCORES_PARQUET)
    candidatos = pd.read_csv(
        CANDIDATOS_CSV, dtype={"SNR": str, "VIB": str, "TestName": str, "FD": str}
    )
    fiables = candidatos[candidatos["tiene_datos"].astype(str).str.lower() == "true"]
    claves_fiables = set(zip(fiables["SNR"], fiables["VIB"], fiables["TestName"]))

    score_cols = [c for c in df.columns if c.startswith("anomaly_score__")]

    grp = df.groupby(["SNR", "VIB", "TestName"])

    agg_max = grp[score_cols].max()
    agg_max.columns = [f"{c}__max" for c in agg_max.columns]

    agg_p95 = grp[score_cols].quantile(0.95)
    agg_p95.columns = [f"{c}__p95" for c in agg_p95.columns]

    resultado_first = grp["Resultado"].first()

    agg = pd.concat([agg_max, agg_p95, resultado_first], axis=1).reset_index()

    agg["_es_nok_fiable"] = agg.apply(
        lambda r: (r["Resultado"].upper() in ("NOK_FUNC", "NOK_FUNC_EST")
                   and (r["SNR"], r["VIB"], r["TestName"]) in claves_fiables),
        axis=1,
    )

    print(f"Tests agregados: {len(agg)}  |  NOK fiables: {agg['_es_nok_fiable'].sum()}")

    resumen = []
    for c in score_cols:
        modelo = c.replace("anomaly_score__", "")
        for agg_tipo in ["max", "p95"]:
            col_agg = f"{c}__{agg_tipo}"
            percentiles = agg[col_agg].rank(pct=True)
            resumen.append({
                "modelo": modelo,
                "agregado": agg_tipo,
                "percentil_medio_NOK": percentiles[agg["_es_nok_fiable"]].mean(),
                "pct_NOK_en_top20%": (percentiles[agg["_es_nok_fiable"]] > 0.80).mean(),
            })

    print("\n===== Comparativa: agregado a nivel de TEST (max / percentil 95) =====")
    print(pd.DataFrame(resumen).to_string(index=False))
    print("\n(Referencia azar: percentil_medio=0.50, pct_en_top20%=0.20)")
    print("(Compara con lo que ya tenias a nivel subciclo: 0.45-0.56 / 0.14-0.28)")


if __name__ == "__main__":
    main()
