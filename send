"""
Test de significancia estadistica (binomial exacto, unilateral) para
comprobar si el % de TESTS NOK reales capturados en el top 20% mas
anomalo es estadisticamente distinguible del azar (20%), dado que solo
se dispone de un numero pequeño de casos NOK reales conocidos.

Hipotesis nula: el modelo no aporta nada, y la probabilidad de que un
NOK real caiga en el 20% mas anomalo es simplemente 0.20 (como si se
eligiera al azar). Se contrasta contra la alternativa de que la
probabilidad real es MAYOR que 0.20 (test unilateral, porque solo nos
interesa demostrar que el modelo ayuda, no que perjudica).

Requiere:
    pip install pandas scipy

Uso:
    python 07_test_significancia.py
"""

import importlib.util
import pandas as pd
from scipy.stats import binomtest

UMBRAL = 0.80  # top 20% mas anomalo

# Cargamos 06_generar_graficas.py como modulo (su nombre empieza por un
# numero, por eso no se puede hacer un "import" normal)
spec = importlib.util.spec_from_file_location("graficas", "06_generar_graficas.py")
graficas = importlib.util.module_from_spec(spec)
spec.loader.exec_module(graficas)


def significancia(agg, agg_tipo):
    score_cols = [c for c in agg.columns if c.startswith("anomaly_score__")]
    n_nok = int(agg["_nok_fiable"].sum())

    filas = []
    for col in score_cols:
        modelo = col.replace("anomaly_score__", "")
        percentiles = agg[col].rank(pct=True)
        k = int((percentiles[agg["_nok_fiable"]] > UMBRAL).sum())

        test = binomtest(k, n_nok, 1 - UMBRAL, alternative="greater")
        ci = test.proportion_ci(confidence_level=0.90)

        filas.append({
            "modelo": modelo,
            "agregado": agg_tipo,
            "n_NOK": n_nok,
            "k_en_top20%": k,
            "pct_observado": round(k / n_nok, 3),
            "IC90%_inferior": round(ci.low, 3),
            "IC90%_superior": round(ci.high, 3),
            "p_valor": round(test.pvalue, 4),
            "significativo (p<0.05)": test.pvalue < 0.05,
        })
    return pd.DataFrame(filas)


def main():
    df = graficas.cargar_datos()

    resultados = []
    for agg_tipo in ["max", "p95"]:
        agg = graficas.agregar_a_nivel_test(df, agg_tipo=agg_tipo)
        resultados.append(significancia(agg, agg_tipo))

    tabla = pd.concat(resultados, ignore_index=True)
    tabla = tabla.sort_values(["agregado", "p_valor"])

    print(f"\n===== Test de significancia (binomial exacto, H1: proporcion > {1-UMBRAL:.0%}) =====")
    print(tabla.to_string(index=False))
    print("\nNota: 'significativo (p<0.05)' con muestras de este tamaño (n_NOK pequeño) "
          "es un criterio exigente -- un p-valor entre 0.05 y 0.15 sigue siendo una "
          "senal razonable a mencionar como 'tendencia', con la cautela debida.")

    tabla.to_csv("test_significancia.csv", index=False)
    print("\nGuardado test_significancia.csv")


if __name__ == "__main__":
    main()
