"""
Resume el chequeo cualitativo a partir de subciclos_con_scores.parquet
(ya generado por 05_train_anomaly_models.py), sin necesidad de reentrenar.

Uso:
    python resumen_chequeo_cualitativo.py
"""

import pandas as pd

SCORES_PARQUET = "subciclos_con_scores.parquet"
CANDIDATOS_CSV = "candidatos_subciclo_alto.csv"


def main():
    df = pd.read_parquet(SCORES_PARQUET)
    candidatos = pd.read_csv(
        CANDIDATOS_CSV, dtype={"SNR": str, "VIB": str, "TestName": str, "FD": str}
    )
    fiables = candidatos[candidatos["tiene_datos"].astype(str).str.lower() == "true"]
    claves_fiables = set(zip(fiables["SNR"], fiables["VIB"], fiables["TestName"]))

    es_nok = df["Resultado"].astype(str).str.upper().isin(["NOK_FUNC", "NOK_FUNC_EST"])
    es_fiable = df.apply(lambda r: (r["SNR"], r["VIB"], r["TestName"]) in claves_fiables, axis=1)
    nok_mask = es_nok & es_fiable

    casos = df.loc[nok_mask]
    print(f"Filas (subciclos) NOK fiables: {len(casos)}")
    print(f"SNR distintos detras de esos casos: {casos['SNR'].nunique()}")
    print("\nSubciclos por SNR:")
    print(casos.groupby("SNR")["Subcycle"].count())

    score_cols = [c for c in df.columns if c.startswith("anomaly_score__")]
    print("\n===== Percentil de anomalia de los casos NOK fiables, por modelo =====")
    resumen = []
    for col in score_cols:
        percentiles = df[col].rank(pct=True)
        resumen.append({
            "modelo": col.replace("anomaly_score__", ""),
            "percentil_medio_NOK": percentiles[nok_mask].mean(),
            "percentil_mediana_NOK": percentiles[nok_mask].median(),
            "pct_NOK_en_top20%": (percentiles[nok_mask] > 0.80).mean(),
        })
    print(pd.DataFrame(resumen).to_string(index=False))


if __name__ == "__main__":
    main()
